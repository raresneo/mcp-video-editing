{
  "name": "mcp-video-editing",
  "version": "1.0.0",
  "description": "MCP server for video/image editing via ffmpeg + sharp, remote URL sources, Supabase persistence.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:client": "node test-client.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@supabase/supabase-js": "^2.45.4",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "p-limit": "^7.3.1",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.26",
    "@types/node": "^20.14.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
