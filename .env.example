# Supabase (folosește ACELAȘI proiect ca mcp-social pentru flux fără pași manuali)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Bucket Storage pentru output (public). Creat automat la boot dacă lipsește.
SUPABASE_BUCKET=media-out

# Secret partajat pentru autorizarea request-urilor MCP (recomandat).
# Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Server
PORT=10000

# Limite
MAX_DOWNLOAD_BYTES=209715200 # 200MB
JOB_TIMEOUT_MS=300000        # 300s
SIGNED_URL_TTL_S=604800      # 7 zile; 0 = URL public direct

# ---- auto_caption ----
# OPȚIONAL. Cu cheie => Whisper cu timestamps word-level (cel mai precis).
# Fără cheie => fallback automat pe Gemini prin Vertex AI (aceleași credentials
# folosite deja de generate_music, deci nu trebuie nimic în plus).
OPENAI_API_KEY=

# Folosit de generate_music și de fallback-ul de transcriere (Vertex AI).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CREDENTIALS_JSON=
